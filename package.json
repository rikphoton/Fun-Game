{
  "name": "neon-pulse-arcade",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:browser": "playwright test",
    "benchmark": "node scripts/benchmark-arcade.mjs",
    "desktop": "vite build && electron .",
    "package": "vite build && node scripts/package-desktop.mjs",
    "package:win": "vite build && node scripts/package-desktop.mjs win32 x64",
    "package:mac": "vite build && node scripts/package-desktop.mjs darwin universal",
    "package:linux": "vite build && node scripts/package-desktop.mjs linux x64",
    "share": "npx localtunnel --port 3000"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "@playwright/test": "^1.64.1",
    "electron": "^36.0.0",
    "vite": "^6.0.0"
  }
}
